# Copy to .env and fill in. .env is gitignored — never commit real keys.

# DeepSeek LLM key — used to synthesize the fill-in-the-blanks form from a
# recording. Optional: without it, Mimic falls back to built-in heuristics.
DEEPSEEK_API_KEY=

# Backend port (frontend + extension expect 4545).
PORT=4545

# When false (default), nothing is charged and all quotas pass — build & test
# freely. Set to true to enforce subscription charges + daily build limits.
BILLING_ENABLED=false

# Postgres connection string. Leave unset for local dev — Mimic falls back to
# local JSON files under backend/data/ automatically. REQUIRED on a stateless
# host like Vercel (no persistent disk) — Vercel's Postgres/Neon integration
# sets this for you when attached to the project.
POSTGRES_URL=

# Required whenever POSTGRES_URL is set (i.e. in production). Without it, the
# key used to encrypt saved login credentials + email configs would regenerate
# on every restart, permanently breaking decryption of anything already saved.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRED_ENCRYPTION_KEY=
